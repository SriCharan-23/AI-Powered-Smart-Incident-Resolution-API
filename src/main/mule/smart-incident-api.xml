        <http:listener-connection host="0.0.0.0" port="8081" />
    </http:listener-config>

    <apikit:config name="smart-incident-api-config" api="smart-incident-api.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" doc:name="Router" doc:id="9e01a74a-b268-495e-9021-8d2be5db4e90" />

    <http:request-config name="HTTP_Request_config" doc:name="HTTP Request config" doc:id="576fccf7-8408-4216-927e-9e3b6603b682">
        <http:request-connection host="generativelanguage.googleapis.com" port="443" protocol="HTTPS" />
    </http:request-config>
    


     <email:smtp-config name="Email_SMTP" doc:name="Email SMTP" doc:id="aef4d9c1-b614-4582-b440-9843b79e577f" >
    <email:smtp-connection 
        host="${smtp.host}"
        port="${smtp.port}"
        user="${smtp.user}"
        password="${smtp.password}"
