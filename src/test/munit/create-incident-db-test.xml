<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="new-test-suite.xml" />
	<munit:test name="create-incident-success-test" doc:id="a323a2ed-ce28-4ed9-b099-63a70c7a852f" >
		<munit:behavior >
			<munit:set-event doc:name="Set Event" doc:id="48c05835-b44a-4160-9fd7-054482615a1e" >
				<munit:payload value='#[{&#10;"customerId":"CUST001",&#10;"title":"Database Timeout",&#10;"description":"Unable to connect DB",&#10;"severity":"HIGH",&#10;"category":"DATABASE",&#10;"contactEmail":"test@gmail.com"&#10;}]' />
			</munit:set-event>
			<munit-tools:mock-when doc:name="Mock when" doc:id="0ab0b228-5704-4523-a20b-7d67f128f093" processor="db:insert">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Insert Incident" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[{&#10;"affectedRows":1&#10;}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock when" doc:id="00c1dada-7246-43cd-863e-0a0ef7c2f879" processor="db:audit">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Audit Insert" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[{&#10;"affectedRows":1&#10;}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock when" doc:id="5c830555-8504-41b4-8fb2-4584350311d1" processor="vm:publish">
				<munit-tools:then-return >
					<munit-tools:payload value='#[{&#10;"status":"queued"&#10;}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<flow-ref doc:name="Flow Reference" doc:id="4e094f8b-8609-41f0-b3e6-3bdcb1e15d71" name="create-incident-db-flow"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that" doc:id="148a56f4-f5ad-4ea7-b0ff-aa1f8308d386" expression="#[payload.status]" is="#[MunitTools::notNullValue()]"/>
		</munit:validation>
	</munit:test>


</mule>
