                        <ee:set-variable variableName="httpStatus">406</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE" doc:name="On Error Propagate" doc:id="a81a2e24-1076-4235-9f83-0d2a1ad4fe03">
                <ee:transform doc:name="Transform Message" doc:id="5aa38cff-3cb6-4842-a812-fef9bbd7fc2a">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Unsupported media type"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">415</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_IMPLEMENTED" doc:name="On Error Propagate" doc:id="87ff0658-265b-4dd9-a5ef-256f07554048">
                <ee:transform doc:name="Transform Message" doc:id="1a1d401e-a296-4fab-bd23-34170ef9505d">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not Implemented"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">501</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>

    <flow name="smart-incident-api-console" doc:id="3c859801-bed8-40d9-a97a-c2a447dda891">
