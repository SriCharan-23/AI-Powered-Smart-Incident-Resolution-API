	<flow name="smart-incident-api-main" doc:id="425270ee-2f5c-44f8-8cea-c0fdb705fe5c">
        <http:listener config-ref="smart-incident-api-httpListenerConfig" path="/api/*" doc:name="Listener" doc:id="d7ca0328-ab97-4fb3-841e-7cc0399716b7">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="smart-incident-api-config" doc:name="APIkit Router" doc:id="feb174ed-26d8-47c3-8be1-a39108348334" />
        <error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST" doc:name="On Error Propagate" doc:id="cd35f669-17e2-46a7-a9a2-d6d50ff27c93">
                <ee:transform doc:name="Transform Message" doc:id="7fd72d2f-cdb6-43d7-b39b-0adc97ee31a5">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Bad request"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND" doc:name="On Error Propagate" doc:id="2f8ecf1a-43e1-491a-a509-603c52a0608b">
                <ee:transform doc:name="Transform Message" doc:id="d319bbea-eea9-4b77-b788-9c47ac9b43bf">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED" doc:name="On Error Propagate" doc:id="7ceb9463-91a2-4dbf-984c-0f794c516dee">
                <ee:transform doc:name="Transform Message" doc:id="4a0e0698-b549-4cd1-b1e4-1dbb9d27076b">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Method not allowed"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">405</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_ACCEPTABLE" doc:name="On Error Propagate" doc:id="0c716822-8521-4506-9b07-7b40df0fe8e5">
                <ee:transform doc:name="Transform Message" doc:id="eeef7fe5-0f16-440e-86bf-fa11c2a7f72f">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not acceptable"}]]></ee:set-payload>
                    </ee:message>
